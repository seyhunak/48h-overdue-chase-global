# ClearDue env template. Copy to .env.local (dev) or .env.production (VPS).
# NEVER commit real keys — .env.local / .env.production are git-ignored.

# --- Convex (client URL is public; deployment selector is local-only) ---
NEXT_PUBLIC_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_SITE_URL=https://YOUR-DEPLOYMENT.convex.site

# --- Clerk auth (use LIVE keys in production) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- Stripe billing (use LIVE keys in production) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREDITS=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAIL=

# --- OneSignal env fallback (preferred path is per-owner /connect) ---
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
# ONESIGNAL_SMS_FROM=

# --- Feature switches ---
# DEBUG_MODE: verbose server logging. Default ON in dev, OFF in production.
# Set "true" in prod only while debugging, then turn it back off.
DEBUG_MODE=false
